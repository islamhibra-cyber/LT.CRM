{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:windows": "node scripts/build-windows.js",
    "build:electron": "node scripts/build-windows.js --electron",
    "package:windows": "node scripts/build-windows.js",
    "package:release": "node scripts/build-windows.js",
    "start:windows": "tsx server.ts",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File ./setup-windows.ps1",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server Application release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.cacao.whatsappcrm",
    "productName": "CACAO WhatsApp CRM",
    "copyright": "Copyright © 2026 Cacao Enterprise",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CACAO WhatsApp CRM",
      "artifactName": "installer/CACAO-WhatsApp-CRM-Setup.${ext}",
      "runAfterFinish": true,
      "include": "scripts/installer.nsh"
    },
    "portable": {
      "artifactName": "portable/CACAO-WhatsApp-CRM-Portable.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "default-data",
        "filter": [
          "*.json",
          "!*.tmp"
        ]
      }
    ]
  }
}
